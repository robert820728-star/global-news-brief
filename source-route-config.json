{
  "schema_version": "1.1.0",
  "description": "Discovery routes only. Candidate verification uses the wider source pool after scoring.",
  "minimum_ready_routes": 1,
  "routes": [
    {
      "source_id": "gdelt",
      "route": "aggregate_api",
      "acquisition_order": ["gdelt_export_24h", "doc_api_optional", "last_known_good_cache"],
      "request_url_template": "https://api.gdeltproject.org/api/v2/doc/doc?query=(sourcelang%3Aenglish%20OR%20sourcelang%3Achinese)&mode=artlist&maxrecords=250&timespan=24h&sort=datedesc&format=json",
      "snapshot_name": "gdelt.discovery.json",
      "source_exhaustion_marker": "\"articles\"",
      "max_attempts": 1,
      "retry_interval_seconds": 0,
      "fallback": {
        "type": "gdelt_export_24h",
        "request_url_template": "http://data.gdeltproject.org/gdeltv2/{yyyyMMddHHmm}00.export.CSV.zip",
        "max_workers": 8
      }
    },
    {
      "source_id": "cna",
      "route": "structured_direct",
      "request_url_template": "https://www.cna.com.tw/cna2018api/api/WNewsList",
      "request_method": "POST",
      "request_json": {"action": "0", "category": "aall", "pagesize": 500, "pageidx": 1},
      "request_headers": {"Referer": "https://www.cna.com.tw/list/aall.aspx"},
      "json_exhaustion_path": ["ResultData", "NextPageIdx"],
      "snapshot_name": "cna.discovery.json"
    },
    {
      "source_id": "chinanews",
      "route": "html_direct",
      "request_url_template": "https://www.chinanews.com.cn/scroll-news/{yyyy}/{MMdd}/news.shtml",
      "date_offset_days": 0,
      "snapshot_name": "chinanews.discovery.html",
      "source_exhaustion_marker": "</html>"
    }
  ]
}
