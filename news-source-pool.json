{
  "schema_version": "1.2.0",
  "window_hours": 24,
  "per_source_rank_limit": 30,
  "primary_sources_per_section": 5,
  "source_scan_evidence_required": true,
  "acquisition_policy": {
    "route_order": ["structured_direct", "html_direct", "same_source_alternate", "browser_rendered_if_permitted"],
    "browser_fallback_triggers": ["dynamic_content_missing", "parse_failure"],
    "cross_source_substitution_forbidden": true,
    "browser_snapshot_required_when_used": true,
    "browser_must_not_be_a_runtime_dependency": true,
    "configured_primary_sources_must_pass_non_browser_health_check": true
  },
  "mandatory_overflow_triggers": [
    "major_disaster", "epidemic", "war_or_military", "diplomacy_escalation",
    "election", "central_bank_or_financial_shock", "major_cybersecurity",
    "critical_infrastructure", "major_scientific_breakthrough",
    "cultural_industry_or_creator_ecosystem", "official_emergency_alert"
  ],
  "cultural_industry_event_rule": {
    "first_large_award_suspension_min_grade": "C",
    "repeat_without_material_change_allowed_grades": ["C-", "D"],
    "material_change_requires_regrading": true
  },
  "conflict_grading_policy": {
    "border_skirmish_default_grade": "D",
    "border_exceptions": ["monitored_section", "elevated_war_or_border_weight", "formal_war", "de_facto_war_scale"],
    "ongoing_conflict_routine_update_default_grade": "D",
    "ongoing_conflict_exceptions": ["battlefield_reversal_or_material_escalation", "peace_or_ceasefire_material_change", "new_country_or_theatre", "external_system_impact"],
    "parent_conflict_grade_inheritance_forbidden": true,
    "source_count_must_not_change_grade": true
  },
  "ranking": {
    "method": "public_value_v1",
    "score_range": [0, 100],
    "dimensions": {
      "public_impact": 30,
      "geographic_or_population_scope": 20,
      "urgency_and_safety": 15,
      "structural_or_policy_significance": 15,
      "material_new_development": 10,
      "core_section_relevance": 10
    },
    "tie_breakers": ["newer_published_at", "more_direct_primary_evidence", "stable_url"]
  },
  "section_sources": {
    "TWN": ["cna", "pts", "udn", "tvbs", "ebc"],
    "CHN": ["xinhua", "caixin", "chinanews", "jiemian", "yicai"],
    "GLB": ["reuters", "ap", "guardian", "aljazeera", "cbs_news"]
  },
