{
  "schema_version": "1.3.0",
  "window_hours": 24,
  "per_source_rank_limit": 30,
  "primary_sources_per_section": 5,
  "source_scan_evidence_required": true,
  "discovery_policy": {
    "strategy": "aggregate_then_regional_supplements",
    "minimum_ready_sources": 1,
    "source_failure_policy": "degrade_not_block",
    "stop_only_when_no_verifiable_candidates": true,
    "deduplicate_before_scoring": true
  },
  "discovery_sources": [
    {
      "source_id": "gdelt",
      "name": "GDELT DOC 2.0",
      "homepage": "https://api.gdeltproject.org/",
      "sections": ["TWN", "CHN", "GLB"],
      "default_section": "GLB",
      "role": "primary_aggregator",
      "allow_external_article_urls": true
    },
    {
      "source_id": "cna",
      "name": "Central News Agency",
      "homepage": "https://www.cna.com.tw/",
      "sections": ["TWN"],
      "role": "regional_supplement",
      "allow_external_article_urls": false
    },
    {
      "source_id": "chinanews",
      "name": "China News Service",
      "homepage": "https://www.chinanews.com.cn/",
      "sections": ["CHN"],
      "role": "regional_supplement",
      "allow_external_article_urls": false
    }
  ],
  "verification_policy": {
    "after_scoring": true,
    "minimum_grade": "C",
    "verify_against_original_or_independent_reliable_source": true,
    "single_reliable_source_allowed_with_note": true,
    "verification_must_not_expand_candidate_pool_without_scoring": true,
    "images_after_verification": true,
    "category_routes": {
      "science_technology_medicine": ["paper_or_journal_record", "peer_review_status", "independent_expert_or_follow_up"],
      "war_military": ["party_a_account", "party_b_account", "independent_or_third_party_when_available"],
      "disaster_accident": ["timestamped_official_statistics", "emergency_or_medical_record", "discrepancy_note_when_counts_conflict"],
      "economy_business": ["official_statistics", "regulatory_filing", "market_or_company_primary_data"],
      "law_policy_election": ["judgment_statute_or_signed_text", "responsible_authority", "plural_independent_observation"],
      "public_health": ["health_authority", "international_body", "research_evidence"]
    },
    "official_source_bias_guard": {
      "official_claim_is_not_automatic_truth": true,
      "china_requires_non_official_comparison_for_contested_claims": true,
      "disclose_possible_omission_or_concealment": true
    },
    "media_evidence_guard": {
      "syndicated_or_copied_reports_count_as_one_chain": true,
      "trace_to_earliest_attributable_record": true,
      "domain_expertise_and_method_required_for_expert_weight": true,
      "general_media_cannot_replace_domain_evidence": true,
      "timely_reporting_without_official_record_allowed": true,
      "missing_primary_record_requires_reader_note": true,
      "unverified_details_remain_provisional": true
    }
  },
  "acquisition_policy": {
    "route_order": ["aggregate_api", "structured_direct", "html_direct", "browser_or_web_search_final_fallback"],
    "browser_fallback_triggers": ["dynamic_content_missing", "parse_failure"],
    "cross_source_substitution_forbidden": false,
    "browser_snapshot_required_when_used": true,
    "browser_must_not_be_a_runtime_dependency": true,
    "configured_primary_sources_must_pass_non_browser_health_check": false
  },
  "mandatory_overflow_triggers": [
    "major_disaster", "epidemic", "war_or_military", "diplomacy_escalation",
    "election", "central_bank_or_financial_shock", "major_cybersecurity",
    "critical_infrastructure", "major_scientific_breakthrough",
    "cultural_industry_or_creator_ecosystem", "official_emergency_alert",
    "coverage_guard_recovery"
  ],
  "cultural_industry_event_rule": {
    "first_large_award_suspension_min_grade": "C",
    "repeat_without_material_change_allowed_grades": ["C-", "D"],
    "material_change_requires_regrading": true
  },
  "conflict_grading_policy": {
    "border_skirmish_default_grade": "D",
    "border_exceptions": ["monitored_section", "elevated_war_or_border_weight", "formal_war", "de_facto_war_scale"],
    "ongoing_conflict_routine_update_default_grade": "D",
    "ongoing_conflict_exceptions": ["battlefield_reversal_or_material_escalation", "peace_or_ceasefire_material_change", "new_country_or_theatre", "external_system_impact"],
    "parent_conflict_grade_inheritance_forbidden": true,
    "source_count_must_not_change_grade": true
  },
  "taiwan_coverage_sweeps": [
    {
      "sweep_id": "economy_trade_industry",
      "topics": ["economy", "trade", "industry", "business_costs", "supply_chain"],
      "window_hours": 24,
      "result_limit": 5,
      "same_source_only": false
    },
    {
      "sweep_id": "health_food_consumer",
      "topics": ["food_safety", "medicine", "consumer_safety", "recall", "public_health"],
      "window_hours": 24,
      "result_limit": 5,
      "same_source_only": false
    },
    {
      "sweep_id": "central_policy_institutions",
      "topics": ["central_budget", "legislation", "constitutional_action", "public_service_operation"],
      "window_hours": 24,
      "result_limit": 5,
      "same_source_only": false
    }
  ],
  "ranking": {
    "method": "public_value_v1",
    "score_range": [0, 100],
    "dimensions": {
      "public_impact": 30,
      "geographic_or_population_scope": 20,
      "urgency_and_safety": 15,
      "structural_or_policy_significance": 15,
      "material_new_development": 10,
      "core_section_relevance": 10
    },
    "tie_breakers": ["newer_published_at", "more_direct_primary_evidence", "stable_url"]
  },
  "section_sources": {
    "TWN": ["cna", "pts", "udn", "tvbs", "ebc"],
    "CHN": ["xinhua", "caixin", "chinanews", "jiemian", "yicai"],
    "GLB": ["reuters", "ap", "guardian", "aljazeera", "cbs_news"]
  },
  "sources": [
    {"source_id":"cna","name":"中央通訊社","homepage":"https://www.cna.com.tw/list/aall.aspx","section":"TWN","categories":["politics","economy","technology","public_safety"],"role":"taiwan_wire"},
    {"source_id":"pts","name":"公視新聞網","homepage":"https://news.pts.org.tw/","section":"TWN","categories":["public_policy","society","politics","public_safety"],"role":"public_service_media"},
    {"source_id":"udn","name":"聯合新聞網","homepage":"https://udn.com/news/index","section":"TWN","categories":["politics","society","economy","international"],"role":"general_media"},
    {"source_id":"tvbs","name":"TVBS 新聞網","homepage":"https://news.tvbs.com.tw/","section":"TWN","categories":["politics","society","international","public_safety","economy"],"role":"general_media"},
    {"source_id":"ebc","name":"東森新聞","homepage":"https://news.ebc.net.tw/","section":"TWN","categories":["politics","society","international","public_safety","economy"],"role":"general_media"},
    {"source_id":"xinhua","name":"新華社／新華網","homepage":"https://www.news.cn/","section":"CHN","categories":["policy","economy","disaster","official_positions"],"role":"china_state_primary"},
    {"source_id":"caixin","name":"財新","homepage":"https://www.caixin.com/","section":"CHN","categories":["economy","finance","business","investigations"],"role":"china_independent_business"},
    {"source_id":"chinanews","name":"中國新聞網","homepage":"https://www.chinanews.com.cn/","section":"CHN","categories":["politics","society","economy","regional"],"role":"china_wire"},
    {"source_id":"jiemian","name":"界面新聞","homepage":"https://www.jiemian.com/","section":"CHN","categories":["society","policy","business","finance","technology"],"role":"general_business_media"},
    {"source_id":"yicai","name":"第一財經","homepage":"https://www.yicai.com/","section":"CHN","categories":["economy","finance","business","technology"],"role":"business_media"},
    {"source_id":"reuters","name":"Reuters","homepage":"https://www.reuters.com/world/","section":"GLB","categories":["politics","economy","business","technology","conflict","disaster"],"role":"independent_wire"},
    {"source_id":"ap","name":"Associated Press","homepage":"https://apnews.com/world-news","section":"GLB","categories":["breaking","politics","conflict","disaster","public_safety"],"role":"independent_wire"},
    {"source_id":"guardian","name":"The Guardian","homepage":"https://www.theguardian.com/world","section":"GLB","categories":["world","politics","conflict","society","climate"],"role":"international_general_media"},
    {"source_id":"aljazeera","name":"Al Jazeera English","homepage":"https://www.aljazeera.com/news/","section":"GLB","categories":["world","conflict","diplomacy","humanitarian","economy"],"role":"international_general_media"},
    {"source_id":"cbs_news","name":"CBS News World","homepage":"https://www.cbsnews.com/world/","section":"GLB","categories":["world","politics","disaster","public_safety","science"],"role":"international_general_media"}
  ],
  "specialist_supplements": [
    {"source_id":"nature","name":"Nature News","homepage":"https://www.nature.com/news","categories":["science","medicine","climate","research"],"trigger":"science_or_research"},
    {"source_id":"who_don","name":"WHO Disease Outbreak News","homepage":"https://www.who.int/emergencies/disease-outbreak-news","categories":["public_health","epidemic"],"trigger":"public_health_or_epidemic"}
  ]
}
