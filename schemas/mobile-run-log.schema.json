{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robert820728-star/global-news-brief/schemas/mobile-run-log.schema.json",
  "title": "Mobile scheduled-run log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_mode",
    "delivery_profile",
    "native_media_status",
    "capability_limitations",
    "run_id",
    "scheduled_for",
    "status",
    "current_stage",
    "stage_index",
    "last_completed_stage",
    "main_sha",
    "window",
    "updated_at",
    "last_error",
    "delivery_status",
    "client_confirmation_supported",
    "reader_artifact",
    "candidate_audit_artifact",
    "verification_artifact",
    "map_decisions_artifact",
    "image_evidence_artifact",
    "durable_audit_status",
    "durable_audit_artifact"
  ],
  "properties": {
    "schema_version": { "const": "1.6.0" },
    "execution_mode": { "enum": ["full-runtime", "mobile-native"] },
    "delivery_profile": {
      "enum": ["full-assets", "reader-canonical-capability-degraded"]
    },
    "native_media_status": { "enum": ["available", "unavailable"] },
    "capability_limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["NATIVE_MEDIA_UNAVAILABLE"] }
    },
    "run_id": {
      "type": "string",
      "pattern": "^gnb-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "scheduled_for": { "type": "string", "format": "date-time" },
    "status": {
      "enum": [
        "awaiting_executor",
        "running",
        "completed",
        "failed",
        "interrupted_by_next_run"
      ]
    },
    "current_stage": {
      "enum": [
        "schedule-prepared",
        "executor-started",
        "main-pinned",
        "workspace-ready",
        "source-scan",
        "candidate-audit",
        "selection-verified",
        "visuals-completed",
        "reader-rendered",
        "github-result-saved",
        "delivery-handoff"
      ]
    },
    "stage_index": { "type": "integer", "minimum": 0, "maximum": 10 },
    "last_completed_stage": {
      "type": ["string", "null"]
    },
    "main_sha": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "window": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "timezone"],
          "properties": {
            "start": { "type": "string", "format": "date-time" },
            "end": { "type": "string", "format": "date-time" },
            "timezone": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "last_error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "delivery_status": {
      "enum": ["not_ready", "reader_saved", "handoff_started", "client_confirmed"]
    },
    "client_confirmation_supported": { "type": "boolean" },
    "candidate_audit_artifact": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "path", "blob_sha", "run_id", "main_sha", "window"],
          "properties": {
            "branch": { "const": "run-logs" },
            "path": {
              "type": "string",
              "pattern": "^logs/runs/gnb-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}/candidate-audit\\.json$"
            },
            "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "run_id": { "type": "string", "pattern": "^gnb-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$" },
            "main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "window": { "$ref": "#/properties/window/oneOf/1" }
          }
        }
      ]
    },
    "verification_artifact": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "path", "blob_sha", "run_id", "main_sha", "window"],
          "properties": {
            "branch": { "const": "run-logs" },
            "path": {
              "type": "string",
              "pattern": "^logs/runs/gnb-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}/verification\\.json$"
            },
            "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "run_id": { "type": "string", "pattern": "^gnb-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$" },
            "main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "window": { "$ref": "#/properties/window/oneOf/1" }
          }
        }
      ]
    },
    "map_decisions_artifact": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "path", "blob_sha", "run_id", "main_sha", "window"],
          "properties": {
            "branch": { "const": "run-logs" },
            "path": {
              "type": "string",
              "pattern": "^logs/runs/gnb-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}/map-decisions\\.json$"
            },
            "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "run_id": { "type": "string", "pattern": "^gnb-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$" },
            "main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "window": { "$ref": "#/properties/window/oneOf/1" }
          }
        }
      ]
    },
    "image_evidence_artifact": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "path", "blob_sha", "run_id", "main_sha", "window"],
          "properties": {
            "branch": { "const": "run-logs" },
            "path": {
              "type": "string",
              "pattern": "^logs/runs/gnb-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}/image-evidence\\.json$"
            },
            "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "run_id": { "type": "string", "pattern": "^gnb-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$" },
            "main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "window": { "$ref": "#/properties/window/oneOf/1" }
          }
        }
      ]
    },
    "durable_audit_status": {
      "enum": [
        "not_started",
        "updated",
        "preserved_merge_deferred",
        "current_run_only"
      ]
    },
    "durable_audit_artifact": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "path", "blob_sha"],
          "properties": {
            "branch": { "const": "run-logs" },
            "path": { "const": "logs/latest-candidate-audit.json" },
            "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        }
      ]
    },
    "reader_artifact": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "path", "blob_sha", "run_id", "main_sha", "window"],
          "properties": {
            "branch": { "const": "run-logs" },
            "path": { "const": "logs/latest-reader.md" },
            "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "run_id": { "type": "string", "pattern": "^gnb-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$" },
            "main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "window": { "$ref": "#/properties/window/oneOf/1" }
          }
        }
      ]
    }
  }
}


