{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/news-source-candidate-list.schema.json",
  "type": "object",
  "required": ["schema_version", "window_start", "window_end", "source_count", "sources", "items"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "source_count": {"const": 15},
    "sources": {
      "type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "source_id", "source_name", "section", "title", "summary", "published_at", "url", "categories", "importance_hint", "acquisition_route", "canonical_url", "normalized_title", "dedup_seed", "snapshot_path", "page_index"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 12},
          "source_id": {"type": "string", "minLength": 1},
          "source_name": {"type": "string", "minLength": 1},
          "section": {"enum": ["TWN", "CHN", "GLB"]},
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "published_at": {"type": "string", "format": "date-time"},
          "url": {"type": "string", "format": "uri"},
          "categories": {"type": "array", "items": {"type": "string"}},
          "importance_hint": {"type": "string", "minLength": 1},
          "acquisition_route": {"enum": ["structured_direct", "html_direct", "browser_rendered", "same_source_alternate"]},
          "canonical_url": {"type": "string", "format": "uri"},
          "normalized_title": {"type": "string", "minLength": 1},
          "dedup_seed": {"type": "string", "minLength": 16},
          "snapshot_path": {"type": "string", "minLength": 1},
          "page_index": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
