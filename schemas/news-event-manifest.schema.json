{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robert820728-star/global-news-brief/schemas/news-event-manifest.schema.json",
  "title": "每日新聞事件清單",
  "description": "新聞技能共用的最終事件資料格式。子技能只能修改自己擁有的欄位。",
  "type": "object",
  "required": [
    "schema_version",
    "run",
    "sections",
    "stage_status",
    "recovery",
    "events",
    "final_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "main_sha",
        "generated_at",
        "timezone",
        "window_start",
        "window_end",
        "language"
      ],
      "properties": {
        "run_id": { "type": "string", "pattern": "^gnb-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$" },
        "main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "generated_at": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 },
        "window_start": { "type": "string", "format": "date-time" },
        "window_end": { "type": "string", "format": "date-time" },
        "language": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "order"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      }
    },
    "stage_status": {
      "type": "object",
      "properties": {
        "select-news-events": { "$ref": "#/$defs/stageState" },
        "verify-news-events": { "$ref": "#/$defs/stageState" },
        "build-news-maps": { "$ref": "#/$defs/stageState" },
        "build-news-charts": { "$ref": "#/$defs/stageState" },
        "collect-news-images": { "$ref": "#/$defs/stageState" },
        "recover-news-run": { "$ref": "#/$defs/stageState" },
        "render": { "$ref": "#/$defs/stageState" },
        "validate": { "$ref": "#/$defs/stageState" }
      },
      "additionalProperties": false
    },
    "recovery": { "$ref": "#/$defs/recoveryState" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "final_status": {
      "enum": ["draft", "ready", "failed"]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stageState": {
      "enum": ["pending", "running", "completed", "failed", "skipped"]
    },
    "recoveryState": {
      "type": "object",
      "required": [
        "status",
        "max_attempts_per_target",
        "attempts",
        "unresolved_targets"
      ],
      "properties": {
        "status": { "enum": ["pending", "recovering", "completed", "exhausted"] },
        "max_attempts_per_target": { "type": "integer", "minimum": 1, "maximum": 5 },
        "attempts": {
          "type": "array",
          "items": { "$ref": "#/$defs/recoveryAttempt" }
        },
        "unresolved_targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/recoveryTarget" }
        }
      },
      "additionalProperties": false
    },
    "recoveryAttempt": {
      "type": "object",
      "required": [
        "target_stage",
        "event_id",
        "attempt",
        "started_at",
        "ended_at",
        "outcome",
        "error_code",
        "message"
      ],
      "properties": {
        "target_stage": {
          "enum": [
            "verify-news-events",
            "build-news-maps",
            "build-news-charts",
            "collect-news-images",
            "render",
            "validate"
          ]
        },
        "event_id": { "type": ["string", "null"], "pattern": "^[A-Z]{3}-[0-9]{2,3}$" },
        "attempt": { "type": "integer", "minimum": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["succeeded", "failed"] },
        "error_code": { "type": ["string", "null"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "recoveryTarget": {
      "type": "object",
      "required": ["target_stage", "event_id", "last_error_code", "last_message"],
      "properties": {
        "target_stage": {
          "enum": [
            "verify-news-events",
            "build-news-maps",
            "build-news-charts",
            "collect-news-images",
            "render",
            "validate"
          ]
        },
        "event_id": { "type": ["string", "null"], "pattern": "^[A-Z]{3}-[0-9]{2,3}$" },
        "last_error_code": { "type": ["string", "null"] },
        "last_message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "primary_section",
        "title",
        "grade",
        "selection",
        "verification",
        "map",
        "charts",
        "images",
        "detail"
      ],
      "properties": {
        "event_id": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2,3}$" },
        "primary_section": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "grade": {
          "enum": [
            "SS", "S+", "S", "S-", "A+", "A", "A-",
            "B+", "B", "B-", "C+", "C", "C-"
          ]
        },
        "selection": { "$ref": "#/$defs/selection" },
        "verification": { "$ref": "#/$defs/verification" },
        "map": { "$ref": "#/$defs/mapResult" },
        "charts": { "$ref": "#/$defs/chartResult" },
        "images": { "$ref": "#/$defs/imageResult" },
        "detail": { "$ref": "#/$defs/detail" }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": [
        "dedup_key",
        "category",
        "impact_scope",
        "reason",
        "candidate_urls",
        "news_time",
        "event_time"
      ],
      "properties": {
        "dedup_key": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "impact_scope": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "candidate_urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "news_time": { "type": "string", "minLength": 1 },
        "event_time": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "finding",
        "search_performed",
        "independent_source_count",
        "sources",
        "claims",
        "uncertainties",
        "source_limit_note",
        "positions",
        "reader_wording",
        "verified_at"
      ],
      "properties": {
        "status": { "enum": ["pending", "completed", "failed"] },
        "finding": {
          "enum": [
            "pending",
            "corroborated",
            "single_reliable_source",
            "conflicting",
            "insufficient"
          ]
        },
        "search_performed": { "type": "boolean" },
        "independent_source_count": { "type": "integer", "minimum": 0 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim" }
        },
        "uncertainties": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_limit_note": { "type": ["string", "null"] },
        "positions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reader_wording": { "type": "string" },
        "verified_at": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "name",
        "url",
        "role",
        "producer",
        "independence_group",
        "published_at",
        "accessed_at",
        "evidence_type",
        "claim_ids",
        "limitations"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "role": { "type": "string", "minLength": 1 },
        "producer": { "type": "string", "minLength": 1 },
        "independence_group": { "type": "string", "minLength": 1 },
        "published_at": { "type": ["string", "null"] },
        "accessed_at": { "type": "string", "minLength": 1 },
        "evidence_type": {
          "enum": ["supports", "partially_supports", "contradicts", "background"]
        },
        "claim_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "text", "status", "source_ids"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["supported", "partially_supported", "conflicting", "unverified"]
        },
        "source_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "mapResult": {
      "type": "object",
      "required": ["required", "status", "rationale", "assets", "omission_reason"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "enum": ["pending", "ready", "not_required", "omitted"] },
        "rationale": { "type": "string" },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/mapAsset" }
        },
        "omission_reason": { "type": ["string", "null"] },
        "reader_omission_note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "mapAsset": {
      "type": "object",
      "required": [
        "path",
        "caption",
        "style_id",
        "style_reference",
        "generator",
        "source_urls",
        "visual_checked",
        "width",
        "height",
        "place_labels",
        "canvas_scope",
        "base_map"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^(sandbox:)?/" },
        "caption": { "type": "string", "minLength": 1 },
        "style_id": { "const": "yellow-admin-v2" },
        "style_reference": { "const": "maps/style.json" },
        "generator": { "const": "scripts/render_base_maps.py" },
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "visual_checked": { "const": true },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "place_labels": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "canvas_scope": {
          "enum": ["full_world", "full_section", "regional_detail"]
        },
        "base_map": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "imageResult": {
      "type": "object",
      "required": [
        "required", "status", "source_checks",
        "professional_visual_required", "professional_visual_status",
        "professional_source_checks", "professional_omission_reason",
        "assets", "omission_reason"
      ],
      "properties": {
        "required": { "const": true },
        "status": { "enum": ["pending", "ready", "not_required", "omitted"] },
        "source_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/imageSourceCheck" }
        },
        "professional_visual_required": { "type": "boolean" },
        "professional_visual_status": {
          "enum": ["pending", "ready", "not_required", "not_available"]
        },
        "professional_source_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/imageSourceCheck" }
        },
        "professional_omission_reason": { "type": ["string", "null"] },
        "materialization_manifest_path": { "type": ["string", "null"], "pattern": "^(sandbox:)?/" },
        "assets": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/imageAsset" }
        },
        "omission_reason": { "type": ["string", "null"] },
        "reader_omission_note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "chartResult": {
      "type": "object",
      "required": ["required", "status", "rationale", "assets", "omission_reason"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "enum": ["pending", "ready", "not_required", "omitted"] },
        "rationale": { "type": "string" },
        "assets": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/chartAsset" }
        },
        "omission_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "chartAsset": {
      "type": "object",
      "required": [
        "path", "caption", "source_names", "source_urls", "chart_type",
        "data_points", "labels", "numeric_values", "unit", "chart_purpose",
        "visual_checked", "data_checked", "width", "height"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^(sandbox:)?/" },
        "caption": { "type": "string", "minLength": 1 },
        "source_names": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_urls": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "chart_type": { "enum": ["metric_card", "bar", "line", "area", "scatter", "pie", "table"] },
        "chart_purpose": { "enum": ["single_metric", "comparison", "trend", "proportion", "distribution", "lookup"] },
        "data_points": { "type": "integer", "minimum": 1 },
        "labels": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "numeric_values": {
          "type": "array", "minItems": 1,
          "items": { "type": "number" }
        },
        "unit": { "type": "string", "minLength": 1 },
        "highlight_reason": { "type": ["string", "null"] },
        "x_axis_label": { "type": ["string", "null"] },
        "y_axis_label": { "type": ["string", "null"] },
        "visual_checked": { "const": true },
        "data_checked": { "const": true },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "imageSourceCheck": {
      "type": "object",
      "required": ["source_url", "checked", "checked_at", "inspection_method", "evidence_path", "detected_image_urls", "usable_image_found", "attempts", "outcome", "failure_detail"],
      "properties": {
        "source_url": { "type": "string", "format": "uri" },
        "checked": { "const": true },
        "checked_at": { "type": "string", "format": "date-time" },
        "inspection_method": { "enum": ["browser", "html_extract", "official_api"] },
        "evidence_path": { "type": "string", "pattern": "^(sandbox:)?/" },
        "detected_image_urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "usable_image_found": { "type": "boolean" },
        "attempts": { "type": "integer", "minimum": 1 },
        "outcome": {
          "enum": ["attached", "no_usable_image", "acquisition_failed"]
        },
        "failure_detail": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "imageAsset": {
      "type": "object",
      "required": [
        "path",
        "caption",
        "source_name",
        "source_url",
        "source_image_url",
        "materialized_by",
        "kind",
        "published_at",
        "content_sha256",
        "visual_checked",
        "time_checked",
        "width",
        "height"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^(sandbox:)?/" },
        "caption": { "type": "string", "minLength": 1 },
        "source_name": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "source_image_url": { "type": "string", "format": "uri" },
        "materialized_by": { "const": "scripts/materialize_news_images.py" },
        "kind": {
          "enum": ["official_information", "professional_information", "news_photo"]
        },
        "published_at": { "type": ["string", "null"] },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "incremental_information": { "type": ["string", "null"] },
        "visual_checked": { "const": true },
        "time_checked": { "const": true },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "detail": {
      "type": "object",
      "required": ["overview_time", "time", "event_details", "positions", "analysis", "follow_up"],
      "properties": {
        "overview_time": { "type": "string", "minLength": 1 },
        "time": { "type": "string", "minLength": 1 },
        "event_details": { "type": "string", "minLength": 1 },
        "positions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "analysis": { "type": "string", "minLength": 1 },
        "follow_up": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  }
}
