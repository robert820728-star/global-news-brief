{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "每日新聞候選事件稽核",
  "type": "object",
  "required": ["schema_version", "retention_days", "updated_at", "runs"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "retention_days": {"type": "integer", "const": 14},
    "updated_at": {"type": "string", "format": "date-time"},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}}
  },
  "additionalProperties": false,
  "$defs": {
    "sourceCoverage": {
      "type": "object",
      "required": ["source_id", "status", "within_window_count", "ranked_count", "ranked_items", "selected_for_pool_count", "selected_item_urls", "mandatory_overflow_items", "ranking_completed", "ranking_method", "failure_reason", "scan_window_start", "scan_window_end", "scan_evidence_path"],
      "properties": {
        "source_id": {"type": "string"},
        "status": {"enum": ["completed", "failed"]},
        "within_window_count": {"type": "integer", "minimum": 0},
        "ranked_count": {"type": "integer", "minimum": 0},
        "ranked_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "title", "published_at", "importance_score", "importance_breakdown", "importance_reason"],
            "properties": {
              "url": {"type": "string", "format": "uri"},
              "title": {"type": "string", "minLength": 1},
              "published_at": {"type": "string", "format": "date-time"},
              "importance_score": {"type": "number", "minimum": 0, "maximum": 100},
              "importance_breakdown": {
                "anyOf": [
                  {"$ref": "#/$defs/importanceBreakdown"},
                  {"$ref": "#/$defs/legacyImportanceBreakdown"}
                ]
              },
              "importance_reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        },
        "selected_for_pool_count": {"type": "integer", "minimum": 0},
        "selected_item_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "mandatory_overflow_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "trigger", "reason"],
            "properties": {
              "url": {"type": "string", "format": "uri"},
              "trigger": {"type": "string"},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "ranking_completed": {"type": "boolean"},
        "ranking_method": {"enum": ["public_value_v1", "public_value_v2"]},
        "failure_reason": {"type": ["string", "null"]}
        ,"scan_window_start": {"type": "string", "format": "date-time"}
        ,"scan_window_end": {"type": "string", "format": "date-time"}
        ,"scan_evidence_path": {"type": "string", "pattern": "^(sandbox:)?/"}
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": ["run_id", "generated_at", "window_start", "window_end", "source_coverage", "raw_item_count", "deduplicated_candidate_count", "candidates"],
      "properties": {
        "run_id": {"type": "string"},
        "generated_at": {"type": "string", "format": "date-time"},
        "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"},
        "source_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceCoverage"}},
        "raw_item_count": {"type": "integer", "minimum": 0},
        "article_dispositions": {
          "type": "array",
          "items": {"$ref": "#/$defs/articleDisposition"}
        },
        "processing_counts": {
          "type": "object",
          "required": ["merged_article_row_count", "in_window_article_row_count", "canonical_url_count", "provisional_title_cluster_count", "semantic_event_count", "scored_event_count", "event_evidence_article_row_count", "non_news_article_row_count", "unresolved_article_row_count", "c_or_higher_scored_event_count", "selected_event_count"],
          "properties": {
            "merged_article_row_count": {"type": "integer", "minimum": 0},
            "in_window_article_row_count": {"type": "integer", "minimum": 0},
            "canonical_url_count": {"type": "integer", "minimum": 0},
            "provisional_title_cluster_count": {"type": "integer", "minimum": 0},
            "semantic_event_count": {"type": "integer", "minimum": 0},
            "scored_event_count": {"type": "integer", "minimum": 0},
            "event_evidence_article_row_count": {"type": "integer", "minimum": 0},
            "non_news_article_row_count": {"type": "integer", "minimum": 0},
            "unresolved_article_row_count": {"type": "integer", "minimum": 0},
            "c_or_higher_scored_event_count": {"type": "integer", "minimum": 0},
            "selected_event_count": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "deduplicated_candidate_count": {"type": "integer", "minimum": 0},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
      },
      "additionalProperties": true
    },
    "articleDisposition": {
      "type": "object",
      "required": ["source_id", "url", "disposition", "semantic_event_id", "reason"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "disposition": {"enum": ["event_evidence", "non_news", "unresolved"]},
        "semantic_event_id": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "importanceBreakdown": {
      "type": "object",
      "required": ["public_impact", "geographic_or_population_scope", "urgency_and_safety", "structural_or_policy_significance", "material_new_development", "core_section_relevance"],
      "properties": {
        "public_impact": {"type": "number", "minimum": 0, "maximum": 100, "multipleOf": 5},
        "geographic_or_population_scope": {"type": "number", "minimum": 0, "maximum": 100, "multipleOf": 5},
        "urgency_and_safety": {"type": "number", "minimum": 0, "maximum": 100, "multipleOf": 5},
        "structural_or_policy_significance": {"type": "number", "minimum": 0, "maximum": 100, "multipleOf": 5},
        "material_new_development": {"type": "number", "minimum": 0, "maximum": 100, "multipleOf": 5},
        "core_section_relevance": {"type": "number", "minimum": 0, "maximum": 100, "multipleOf": 5}
      },
      "additionalProperties": false
    },
    "legacyImportanceBreakdown": {
      "description": "Historical continuity only. The latest run is rejected unless it uses public_value_v2.",
      "type": "object",
      "required": ["public_impact", "geographic_or_population_scope", "urgency_and_safety", "structural_or_policy_significance", "material_new_development", "core_section_relevance"],
      "properties": {
        "public_impact": {"type": "number", "minimum": 0, "maximum": 30},
        "geographic_or_population_scope": {"type": "number", "minimum": 0, "maximum": 20},
        "urgency_and_safety": {"type": "number", "minimum": 0, "maximum": 15},
        "structural_or_policy_significance": {"type": "number", "minimum": 0, "maximum": 15},
        "material_new_development": {"type": "number", "minimum": 0, "maximum": 10},
        "core_section_relevance": {"type": "number", "minimum": 0, "maximum": 10}
      },
      "additionalProperties": false
    },
    "dimensionEvidence": {
      "type": "object",
      "required": ["public_impact", "geographic_or_population_scope", "urgency_and_safety", "structural_or_policy_significance", "material_new_development", "core_section_relevance"],
      "properties": {
        "public_impact": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "geographic_or_population_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "urgency_and_safety": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "structural_or_policy_significance": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "material_new_development": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "core_section_relevance": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "consequenceEvidence": {
      "type": "object",
      "required": ["realized", "ongoing", "potential", "speculative"],
      "properties": {
        "realized": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "ongoing": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "potential": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "speculative": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "evidenceFact": {
      "type": "object",
      "required": ["fact_id", "fact", "fact_type", "consequence_class", "confidence", "source_urls"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^F[0-9]{2,}$"},
        "fact": {"type": "string", "minLength": 1},
        "fact_type": {"enum": ["public_consequence", "directly_affected_scope", "safety_condition", "institutional_change", "material_delta", "section_centrality", "policy_scope", "market_effect", "other"]},
        "consequence_class": {"enum": ["realized", "ongoing", "potential", "speculative"]},
        "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
        "source_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "institutional_mechanism": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "deltaFact": {
      "type": "object",
      "required": ["fact_id", "previous_state", "current_state", "why_material"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^F[0-9]{2,}$"},
        "previous_state": {"type": "string", "minLength": 1},
        "current_state": {"type": "string", "minLength": 1},
        "why_material": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "highScoreChallenge": {
      "type": "object",
      "required": ["dimension", "claim", "counter_question", "supporting_facts", "outcome", "rationale"],
      "properties": {
        "dimension": {"enum": ["public_impact", "geographic_or_population_scope", "urgency_and_safety", "structural_or_policy_significance", "material_new_development", "core_section_relevance", "overall"]},
        "claim": {"type": "string", "minLength": 1},
        "counter_question": {"type": "string", "minLength": 1},
        "supporting_facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outcome": {"enum": ["sustained", "rescore_required"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "crossDimensionRationale": {
      "type": "object",
      "required": ["fact_id", "dimensions", "rationale"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^F[0-9]{2,}$"},
        "dimensions": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["public_impact", "geographic_or_population_scope", "urgency_and_safety", "structural_or_policy_significance", "material_new_development", "core_section_relevance"]}},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "midpointRationale": {
      "type": "object",
      "required": ["dimension", "lower_anchor", "upper_anchor", "supporting_facts", "rationale"],
      "properties": {
        "dimension": {"enum": ["public_impact", "geographic_or_population_scope", "urgency_and_safety", "structural_or_policy_significance", "material_new_development", "core_section_relevance"]},
        "lower_anchor": {"type": "integer", "minimum": 0, "maximum": 90, "multipleOf": 10},
        "upper_anchor": {"type": "integer", "minimum": 10, "maximum": 100, "multipleOf": 10},
        "supporting_facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "eventIdentity": {
      "type": "object",
      "required": ["who_or_what", "what_happened", "where", "when", "semantic_merge_basis"],
      "properties": {
        "who_or_what": {"type": "string", "minLength": 1},
        "what_happened": {"type": "string", "minLength": 1},
        "where": {"type": "string", "minLength": 1},
        "when": {"type": "string", "minLength": 1},
        "country_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]{3}$"}
        },
        "primary_country_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "location_evidence": {"type": "string", "minLength": 1},
        "event_occurred_at": {"type": "string", "format": "date-time"},
        "material_update_at": {"type": "string", "format": "date-time"},
        "material_update_type": {
          "enum": [
            "new_event",
            "official_confirmation",
            "casualty_or_impact_revision",
            "policy_or_legal_change",
            "operational_or_status_change",
            "material_escalation_or_deescalation",
            "ongoing_verified_current_impact",
            "other_verified_material_change"
          ]
        },
        "material_update_evidence": {"type": "string", "minLength": 1},
        "temporal_review": {
          "type": "object",
          "required": ["review_method", "window_status", "active_during_window", "new_or_changed_facts", "repeated_old_facts", "current_window_impact", "comparison_evidence"],
          "properties": {
            "review_method": {"const": "model_content_comparison"},
            "window_status": {"enum": ["new_event", "ongoing_current_impact", "material_update", "old_restatement"]},
            "active_during_window": {"type": "boolean"},
            "new_or_changed_facts": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "repeated_old_facts": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "current_window_impact": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "comparison_evidence": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "semantic_merge_basis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "localDisasterReview": {
      "type": "object",
      "required": ["applies"],
      "properties": {
        "applies": {"type": "boolean"},
        "confirmed_deaths": {"type": "integer", "minimum": 0},
        "special_significance_triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "monitored_region_conflict_escalation_risk",
              "extreme_missing_serious_injury_or_evacuation",
              "major_public_system_disruption",
              "rapidly_expanding_disaster",
              "cross_regional_direct_impact",
              "multinational_direct_impact",
              "rare_disaster_mechanism",
              "regulatory_failure_or_systemic_risk",
              "mass_housing_or_critical_infrastructure_loss",
              "historic_extreme_scale",
              "special_security_or_public_health",
              "other_verified_special_significance"
            ]
          }
        },
        "grade_adjustment_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"applies": {"const": true}}},
          "then": {"required": ["confirmed_deaths", "special_significance_triggers", "grade_adjustment_reason"]}
        }
      ],
      "additionalProperties": false
    },
    "policyGovernanceReview": {
      "type": "object",
      "required": ["applies"],
      "properties": {
        "applies": {"type": "boolean"},
        "triggered_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "official_legal_interpretation",
              "investigation_or_enforcement_referral",
              "binding_or_operational_compliance_request",
              "platform_or_operator_action",
              "multi_agency_coordination",
              "precedent_or_spillover_risk",
              "public_reaction"
            ]
          }
        },
        "legal_basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "official_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "direct_operational_effects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "affected_actor_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cross_agency_effects": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "precedent_or_spillover_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "window_material_effects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
        "unverified_allegations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unverified_allegations_separated": {"type": "boolean"},
        "score_consistency_review": {
          "type": "object",
          "required": ["public_impact_alignment", "scope_alignment", "structural_alignment", "window_alignment", "contradiction_reasons", "why_not_b", "review_outcome"],
          "properties": {
            "public_impact_alignment": {"enum": ["consistent", "contradiction", "unresolved"]},
            "scope_alignment": {"enum": ["consistent", "contradiction", "unresolved"]},
            "structural_alignment": {"enum": ["consistent", "contradiction", "unresolved"]},
            "window_alignment": {"enum": ["consistent", "contradiction", "unresolved"]},
            "contradiction_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "why_not_b": {"type": ["string", "null"]},
            "review_outcome": {"enum": ["consistent", "rescore_required"]}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"applies": {"const": true}}},
          "then": {
            "required": ["triggered_by", "legal_basis", "official_actions", "direct_operational_effects", "affected_actor_classes", "cross_agency_effects", "precedent_or_spillover_scope", "window_material_effects", "evidence_urls", "unverified_allegations", "unverified_allegations_separated", "score_consistency_review"]
          }
        }
      ],
      "additionalProperties": false
    },
    "candidate": {
      "anyOf": [
        {"$ref": "#/$defs/v2Candidate"},
        {"$ref": "#/$defs/legacyCandidate"}
      ]
    },
    "legacyCandidate": {
      "description": "Preserved V1 history for continuity comparison only; never a validated current grade.",
      "type": "object",
      "required": ["candidate_id", "dedup_key", "title", "section", "provisional_grade", "importance_score", "importance_breakdown", "grade_reason", "decision", "reason_code", "reason", "source_ids", "continuity"],
      "properties": {
        "candidate_id": {"type": "string"},
        "dedup_key": {"type": "string"},
        "title": {"type": "string"},
        "section": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "provisional_grade": {"enum": ["SS", "S+", "S", "S-", "A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D", "E"]},
        "importance_score": {"type": "number", "minimum": 0, "maximum": 100},
        "importance_breakdown": {"$ref": "#/$defs/legacyImportanceBreakdown"},
        "grade_reason": {"type": "string", "minLength": 1},
        "decision": {"enum": ["selected", "excluded", "merged", "deferred"]},
        "reason_code": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "continuity": {"type": "object"}
      },
      "additionalProperties": true
    },
    "v2Candidate": {
      "type": "object",
      "required": ["candidate_id", "dedup_key", "title", "section", "scoring_method", "weighted_score", "importance_score", "importance_breakdown", "dimension_evidence", "consequence_evidence", "evidence_facts", "policy_stage", "delta_facts", "high_score_challenges", "overall_high_score_challenge", "cross_dimension_rationales", "midpoint_rationales", "evidence_confidence", "confidence_band", "grade_status", "provisional_grade", "grade_reason", "grading_evidence", "decision", "reason_code", "reason", "source_ids", "source_audit", "continuity"],
      "properties": {
        "candidate_id": {"type": "string"},
        "dedup_key": {"type": "string"},
        "semantic_event_id": {"type": "string", "minLength": 1},
        "event_identity": {"$ref": "#/$defs/eventIdentity"},
        "continuity_key": {"type": ["string", "null"]},
        "title": {"type": "string"},
        "section": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "scoring_method": {"const": "public_value_v2"},
        "weighted_score": {"type": "number", "minimum": 0, "maximum": 100},
        "provisional_grade": {"enum": ["SS", "S+", "S", "S-", "A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D", "E"]},
        "importance_score": {"type": "number", "minimum": 0, "maximum": 100},
        "importance_breakdown": {"$ref": "#/$defs/importanceBreakdown"},
        "dimension_evidence": {"$ref": "#/$defs/dimensionEvidence"},
        "consequence_evidence": {"$ref": "#/$defs/consequenceEvidence"},
        "evidence_facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceFact"}},
        "policy_stage": {"enum": ["not_applicable", "rumor", "consideration", "proposal", "draft", "introduced", "passed", "signed", "effective", "implemented", "measurable_effect"]},
        "delta_facts": {"type": "array", "items": {"$ref": "#/$defs/deltaFact"}},
        "high_score_challenges": {"type": "array", "items": {"$ref": "#/$defs/highScoreChallenge"}},
        "overall_high_score_challenge": {"oneOf": [{"$ref": "#/$defs/highScoreChallenge"}, {"type": "null"}]},
        "cross_dimension_rationales": {"type": "array", "items": {"$ref": "#/$defs/crossDimensionRationale"}},
        "midpoint_rationales": {"type": "array", "items": {"$ref": "#/$defs/midpointRationale"}},
        "evidence_confidence": {"type": "integer", "minimum": 0, "maximum": 100},
        "confidence_band": {"enum": ["high", "medium", "low"]},
        "grade_status": {"enum": ["unscored", "provisional", "validated"]},
        "grade_reason": {"type": "string", "minLength": 1},
        "grading_evidence": {
          "type": "object",
          "required": ["impact_scope_level", "direct_consequences", "structural_significance", "window_material_changes", "why_current_grade", "why_not_higher", "why_not_lower", "border_conflict_review", "ongoing_conflict_review"],
          "properties": {
            "impact_scope_level": {"enum": ["facility", "local", "subregional", "national", "multinational", "global"]},
            "direct_consequences": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "structural_significance": {"type": "string", "minLength": 1},
            "window_material_changes": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "why_current_grade": {"type": "string", "minLength": 1},
            "why_not_higher": {"type": "string", "minLength": 1},
            "why_not_lower": {"type": "string", "minLength": 1},
            "policy_governance_review": {"$ref": "#/$defs/policyGovernanceReview"},
            "local_disaster_review": {"$ref": "#/$defs/localDisasterReview"},
            "border_conflict_review": {
              "type": "object",
              "required": ["is_border_conflict", "formal_war", "de_facto_war_scale", "related_to_monitored_section", "user_weight_elevated", "default_d_applied", "exception_reason"],
              "properties": {
                "is_border_conflict": {"type": "boolean"},
                "formal_war": {"type": "boolean"},
                "de_facto_war_scale": {"type": "boolean"},
                "related_to_monitored_section": {"type": "boolean"},
                "user_weight_elevated": {"type": "boolean"},
